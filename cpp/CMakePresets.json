{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/cpp/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug (development, clangd compile DB)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (pinned flags, published numbers)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug-clang",
      "displayName": "Debug with Clang 20 (second compiler, Mull later)",
      "inherits": "debug",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-20" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-clang", "configurePreset": "debug-clang" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "debug-clang", "inherits": "base", "configurePreset": "debug-clang" }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "debug-clang",
      "steps": [
        { "type": "configure", "name": "debug-clang" },
        { "type": "build", "name": "debug-clang" },
        { "type": "test", "name": "debug-clang" }
      ]
    }
  ]
}
